{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stop Backend :8080",
      "type": "shell",
      "command": "FOR /F \"tokens=5\" %a IN ('netstat -ano ^| findstr \":8080 \" ^| findstr \"LISTENING\"') DO taskkill /PID %a /F",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/C"]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Restart Backend",
      "dependsOrder": "sequence",
      "dependsOn": ["Stop Backend :8080", "Start Backend"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
